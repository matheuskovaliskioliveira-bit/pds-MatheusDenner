
@baseUrl = http://127.0.0.1:5000



GET {{baseUrl}}/donos


### BUSCAR DONO PELO ID

GET {{baseUrl}}/donos/1


### CADASTRAR DONO

# @name criarDono
POST {{baseUrl}}/donos
Content-Type: application/json

{
    "nome": "Joao Silva",
    "telefone": "45999998888"
}


### ATUALIZAR DONO CRIADO

PUT {{baseUrl}}/donos/{{criarDono.response.body.$.id}}
Content-Type: application/json

{
    "nome": "Joao Pedro",
    "telefone": "45988887777"
}


### =====================================
### LISTAR TODOS OS PETS
### =====================================

GET {{baseUrl}}/pets


### BUSCAR PET PELO ID

GET {{baseUrl}}/pets/1


### FILTRAR PETS PELO DONO

GET {{baseUrl}}/pets?dono_id=1


### CADASTRAR NOVO PET

# @name criarPet
POST {{baseUrl}}/pets
Content-Type: application/json

{
    "nome": "Bob",
    "especie": "cachorro",
    "idade": 3,
    "dono_id": 1
}


### ATUALIZAR PET CRIADO

PUT {{baseUrl}}/pets/{{criarPet.response.body.$.id}}
Content-Type: application/json

{
    "nome": "Bob Atualizado",
    "especie": "cachorro",
    "idade": 4,
    "dono_id": 1
}


### TESTAR DONO INEXISTENTE

POST {{baseUrl}}/pets
Content-Type: application/json

{
    "nome": "Teste",
    "especie": "gato",
    "idade": 2,
    "dono_id": 999
}


### =====================================
### AULA 03 - EXERCICIO 1
### =====================================

### VERIFICAR DONO_NOME NO JSON

GET {{baseUrl}}/pets




### LISTAR PETS DO DONO 1

GET {{baseUrl}}/donos/1/pets


### LISTAR PETS DO DONO 2

GET {{baseUrl}}/donos/2/pets


### DONO SEM PETS
### RETORNA LISTA VAZIA NO BANCO INICIAL

GET {{baseUrl}}/donos/3/pets


### DONO INEXISTENTE
### DEVE RETORNAR 404

GET {{baseUrl}}/donos/99999/pets


### =====================================
### AULA 03 - EXERCICIO 3
### =====================================

### DONO COM LISTA DE PETS NO JSON

GET {{baseUrl}}/donos/1?incluir_pets=1


### OUTRO DONO COM SEUS PETS

GET {{baseUrl}}/donos/2?incluir_pets=1


### DONO SEM PETS

GET {{baseUrl}}/donos/3?incluir_pets=1


### =====================================
### TESTAR EXCLUSOES
### =====================================

### EXCLUIR PET CRIADO

DELETE {{baseUrl}}/pets/{{criarPet.response.body.$.id}}


### EXCLUIR DONO CRIADO SEM PETS

DELETE {{baseUrl}}/donos/{{criarDono.response.body.$.id}}


### TENTAR EXCLUIR DONO COM PETS
### DEVE RETORNAR 409

DELETE {{baseUrl}}/donos/1


### PET INEXISTENTE
### DEVE RETORNAR 404

GET {{baseUrl}}/pets/99999
