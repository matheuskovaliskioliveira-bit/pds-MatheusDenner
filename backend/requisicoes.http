
@baseUrl = http://127.0.0.1:5000


### =====================================
### DONOS
### =====================================

### LISTAR TODOS OS DONOS

GET {{baseUrl}}/donos


### BUSCAR DONO PELO ID

GET {{baseUrl}}/donos/1


### CADASTRAR DONO

# @name criarDono
POST {{baseUrl}}/donos
Content-Type: application/json

{
    "nome": "Joao Silva",
    "telefone": "45999998888"
}


### ATUALIZAR DONO CRIADO

PUT {{baseUrl}}/donos/{{criarDono.response.body.$.id}}
Content-Type: application/json

{
    "nome": "Joao Pedro",
    "telefone": "45988887777"
}


### TESTAR DONO COM NOME VAZIO
### DEVE RETORNAR 400

POST {{baseUrl}}/donos
Content-Type: application/json

{
    "nome": "   ",
    "telefone": "45999998888"
}


### =====================================
### PETS
### =====================================

### LISTAR TODOS OS PETS

GET {{baseUrl}}/pets


### BUSCAR PET PELO ID

GET {{baseUrl}}/pets/1


### FILTRAR PETS PELO DONO

GET {{baseUrl}}/pets?dono_id=1


### CADASTRAR NOVO PET

# @name criarPet
POST {{baseUrl}}/pets
Content-Type: application/json

{
    "nome": "Bob",
    "especie": "cachorro",
    "idade": 3,
    "dono_id": 1
}


### ATUALIZAR PET CRIADO

PUT {{baseUrl}}/pets/{{criarPet.response.body.$.id}}
Content-Type: application/json

{
    "nome": "Bob Atualizado",
    "especie": "cachorro",
    "idade": 4,
    "dono_id": 1
}



### EXERCICIO 3 - IDADE COMO TEXTO
### DEVE RETORNAR 400

POST {{baseUrl}}/pets
Content-Type: application/json

{
    "nome": "Teste",
    "especie": "gato",
    "idade": "dois",
    "dono_id": 1
}


### EXERCICIO 3 - IDADE NEGATIVA
### DEVE RETORNAR 400

POST {{baseUrl}}/pets
Content-Type: application/json

{
    "nome": "Teste",
    "especie": "gato",
    "idade": -5,
    "dono_id": 1
}


### EXERCICIO 3 - DONO INEXISTENTE
### DEVE RETORNAR 400

POST {{baseUrl}}/pets
Content-Type: application/json

{
    "nome": "Teste",
    "especie": "gato",
    "idade": 2,
    "dono_id": 999
}


### EXERCICIO 3 - NOME VAZIO
### DEVE RETORNAR 400

POST {{baseUrl}}/pets
Content-Type: application/json

{
    "nome": "   ",
    "especie": "gato",
    "idade": 2,
    "dono_id": 1
}


### TESTAR PUT COM IDADE INVALIDA
### DEVE RETORNAR 400 E NAO ATUALIZAR O PET

PUT {{baseUrl}}/pets/{{criarPet.response.body.$.id}}
Content-Type: application/json

{
    "nome": "Bob Atualizado",
    "especie": "cachorro",
    "idade": -3,
    "dono_id": 1
}


### CONFERIR SE OS PETS INVALIDOS NAO FORAM CADASTRADOS

GET {{baseUrl}}/pets



### VERIFICAR DONO_NOME NO JSON

GET {{baseUrl}}/pets


### LISTAR PETS DO DONO 1

GET {{baseUrl}}/donos/1/pets


### LISTAR PETS DO DONO 2

GET {{baseUrl}}/donos/2/pets


### DONO SEM PETS
### RETORNA LISTA VAZIA NO BANCO INICIAL

GET {{baseUrl}}/donos/3/pets


### DONO INEXISTENTE
### DEVE RETORNAR 404

GET {{baseUrl}}/donos/99999/pets


### DONO COM LISTA DE PETS NO JSON

GET {{baseUrl}}/donos/1?incluir_pets=1


### OUTRO DONO COM SEUS PETS

GET {{baseUrl}}/donos/2?incluir_pets=1


### DONO SEM PETS

GET {{baseUrl}}/donos/3?incluir_pets=1



### EXCLUIR PET CRIADO

DELETE {{baseUrl}}/pets/{{criarPet.response.body.$.id}}


### EXCLUIR DONO CRIADO SEM PETS

DELETE {{baseUrl}}/donos/{{criarDono.response.body.$.id}}


### TENTAR EXCLUIR DONO COM PETS
### DEVE RETORNAR 409

DELETE {{baseUrl}}/donos/1


### PET INEXISTENTE
### DEVE RETORNAR 404

GET {{baseUrl}}/pets/99999
